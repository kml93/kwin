+#include <wayland-server-core.h>
 
 namespace KWin
 {
 
+static const QString s_secretHintMimeType = QStringLiteral("x-kde-passwordManagerHint");
+
+static bool isSameProcess(wl_client *client, wl_client *other)
+{
+    if (!client || !other) {
+        return false;
+    }
+    pid_t clientPid = 0;
+    pid_t otherPid = 0;
+    wl_client_get_credentials(client, &clientPid, nullptr, nullptr);
+    wl_client_get_credentials(other, &otherPid, nullptr, nullptr);
+    return clientPid == otherPid;
+}
+
