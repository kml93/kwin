+
+bool DataControlOfferV1InterfacePrivate::isMimeTypeVisible(const QString &mimeType) const
 {
+    // The hint itself stays visible so clipboard managers still know to ignore the selection.
+    return !redactSecrets || mimeType == s_secretHintMimeType || !source->mimeTypes().contains(s_secretHintMimeType);
 }
 
