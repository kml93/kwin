+
+    bool isMimeTypeVisible(const QString &mimeType) const;
 
     DataControlOfferV1Interface *q;
     QPointer<AbstractDataSource> source;
+    // The owner process keeps full access, e.g. to check the content before clearing it.
+    const bool redactSecrets;
 
